# The account's BIP-39 mnemonic. The scripts derive the native account
# (qor1...) and its ML-DSA-87 key from it and sign hybrid.
# DO NOT commit a real mnemonic. Use a testnet-only account.
QORE_MNEMONIC=

# testnet (qorechain-diana) or mainnet (qorechain-vladi).
QORE_NETWORK=testnet

# The code id to instantiate (from `pnpm query codes` once the upload passed).
QORE_CODE_ID=

# Optional token settings for `pnpm instantiate`.
QORE_TOKEN_NAME=Example Token
QORE_TOKEN_SYMBOL=EXT
QORE_TOKEN_SUPPLY=1000000000
