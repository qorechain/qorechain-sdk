# QoreChain endpoints for the web app (Vite exposes only VITE_-prefixed vars).
# The public REST API sends no CORS headers, so the browser reaches it through
# the Vite dev server: requests to /lcd go to QORE_REST_PROXY_TARGET. The
# scaffolder points the targets at the network you chose.
VITE_QORE_REST_URL=/lcd
QORE_REST_PROXY_TARGET=http://localhost:1317
VITE_QORE_EVM_RPC_URL=http://localhost:8545
