# Endpoints. The scaffolder replaces these with the public endpoints of the
# network you chose; point them at your own node if you run one.
QORE_RPC_URL=http://localhost:26657
QORE_REST_URL=http://localhost:1317
QORE_EVM_RPC_URL=http://localhost:8545

# A funded testnet mnemonic, needed only to broadcast (QORE_BROADCAST=1).
# DO NOT commit a real mnemonic.
QORE_MNEMONIC=
QORE_BROADCAST=0
