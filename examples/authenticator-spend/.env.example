# Authenticator-spend example configuration (all optional; sane defaults built in).
QORE_CHAIN_ID=qorechain-diana
# The canonical PQC-required account the linked key spends from (the owner).
QORE_ACCOUNT=qor1account000000000000000000000000000000
# The relayer that submits + pays fees (a DIFFERENT account than the owner).
QORE_RELAYER=qor1relayer000000000000000000000000000000
# The recipient of the native-lane bank send.
QORE_RECIPIENT=qor1recipient0000000000000000000000000000
# Single-coin amount string.
QORE_AMOUNT=100uqor
# The per-authenticator sequence for (account, pubkey). Query it from chain.
QORE_NONCE=0
